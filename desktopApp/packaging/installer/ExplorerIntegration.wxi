<?xml version="1.0" encoding="utf-8"?>
<Include xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="GameTierExplorerCom" Guid="D80A92DD-3380-4B24-934E-8ED6765D17EF" Win64="yes">
        <RegistryKey Root="HKCU" Key="Software\Classes\CLSID\{9B6ED281-384A-4DBF-98C0-D26B6D41B352}" ForceDeleteOnUninstall="yes">
          <RegistryKey Key="InprocServer32">
            <RegistryValue Type="string" Value="[INSTALLDIR]GameTierExplorer.dll" KeyPath="yes" />
            <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
          </RegistryKey>
        </RegistryKey>
      </Component>
      <Component Id="GameTierExplorerFile" Guid="B24745D8-D697-4519-B2DA-1525D4E84EFA" Win64="yes">
        <RegistryKey Root="HKCU" Key="Software\Classes\*\shell\GameTier.Promote" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="Promote with GameTier" />
          <RegistryValue Name="ExplorerCommandHandler" Type="string" Value="{9B6ED281-384A-4DBF-98C0-D26B6D41B352}" KeyPath="yes" />
          <RegistryValue Name="MultiSelectModel" Type="string" Value="Single" />
        </RegistryKey>
      </Component>
      <Component Id="GameTierExplorerDirectory" Guid="B356D240-36CD-4E18-9AB0-A50FEAA5C558" Win64="yes">
        <RegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\GameTier.Promote" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="Promote with GameTier" />
          <RegistryValue Name="ExplorerCommandHandler" Type="string" Value="{9B6ED281-384A-4DBF-98C0-D26B6D41B352}" KeyPath="yes" />
          <RegistryValue Name="MultiSelectModel" Type="string" Value="Single" />
        </RegistryKey>
      </Component>
    </DirectoryRef>
    <ComponentGroup Id="GameTierExplorer">
      <ComponentRef Id="GameTierExplorerCom" />
      <ComponentRef Id="GameTierExplorerFile" />
      <ComponentRef Id="GameTierExplorerDirectory" />
    </ComponentGroup>
  </Fragment>
</Include>
